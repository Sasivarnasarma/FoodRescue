rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }

    function auditPath(id) {
      return /databases/$(database)/documents/adminAuditLogs/$(id);
    }

    function listingPath(id) {
      return /databases/$(database)/documents/foodListings/$(id);
    }

    function requestPath(listingId, organizationUid) {
      return /databases/$(database)/documents/foodListings/$(listingId)/requests/$(organizationUid);
    }

    function isApprovedProvider(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(userPath(uid)) && exists(profilePath(uid))
        && get(userPath(uid)).data.role == 'provider'
        && get(userPath(uid)).data.accountStatus == 'active'
        && get(profilePath(uid)).data.verificationStatus == 'approved';
    }

    function isApprovedOrganization(uid) {
      return request.auth != null && request.auth.uid == uid
        && isEligibleOrganization(uid);
    }

    function isEligibleOrganization(uid) {
      return exists(userPath(uid)) && exists(profilePath(uid))
        && get(userPath(uid)).data.role == 'organization'
        && get(userPath(uid)).data.accountStatus == 'active'
        && get(profilePath(uid)).data.verificationStatus == 'approved';
    }

    function validPickupCollection(listing, candidate) {
      return request.time >= listing.pickupStartsAt
        && request.time < listing.pickupDeadline
        && candidate.recipientConfirmedAt is timestamp
        && candidate.recipientConfirmedAt >= listing.pickupStartsAt
        && candidate.recipientConfirmedAt <= request.time
        && request.time <= candidate.recipientConfirmedAt + duration.value(5, 'm')
        && isEligibleOrganization(listing.acceptedOrganizationUid);
    }

    function isSelectedAssignment(listingId, organizationUid) {
      return get(listingPath(listingId)).data.status == 'assigned'
        && get(listingPath(listingId)).data.acceptedOrganizationUid == organizationUid;
    }
    function isListingProvider(listing) {
      return request.auth != null && listing.providerUid == request.auth.uid
        && isApprovedProvider(request.auth.uid);
    }

    function isAssignedRecipient(listing) {
      return request.auth != null && listing.status == 'assigned'
        && listing.acceptedOrganizationUid == request.auth.uid
        && isApprovedOrganization(request.auth.uid);
    }

    function canReconcileListing(listing) {
      return isAdmin() || isListingProvider(listing) || isAssignedRecipient(listing);
    }
    function exactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validText(value, max) {
      return value is string && value.size() <= max && value.matches('(?s).*\\S.*');
    }

    function validListingStatus(status) {
      return status in ['draft', 'open', 'assigned', 'collected', 'cancelled', 'expired'];
    }

    function validListingDetails(data) {
      return validText(data.title, 120)
        && validText(data.description, 1000)
        && data.category in ['Bakery', 'Produce', 'Prepared Meals', 'Dairy & Eggs', 'Meat & Poultry', 'Pantry & Dry Goods', 'Beverages', 'Other']
        && data.quantity is int && data.quantity > 0
        && data.unit in ['pack', 'portion', 'item', 'g']
        && data.storageRequirement in ['ambient', 'chilled', 'frozen']
        && data.storageInstructions is string && data.storageInstructions.size() <= 500
        && data.allergenInfo is string && data.allergenInfo.size() <= 500
        && data.allergenDeclaration in ['provided', 'unknown']
        && validText(data.pickupAddress, 200)
        && data.pickupLocation is latlng
        && data.pickupStartsAt is timestamp
        && data.pickupDeadline is timestamp
        && data.pickupStartsAt < data.pickupDeadline
        && (!('useByAt' in data) || (data.useByAt is timestamp && data.pickupDeadline <= data.useByAt))
        && (!('bestBeforeAt' in data) || data.bestBeforeAt is timestamp)
        && (!('demoImageKey' in data) || (data.demoImageKey is string && data.demoImageKey.size() <= 100));
    }

    function isParentListingDraft(id, uid) {
      return exists(listingPath(id))
        && getAfter(listingPath(id)).data.providerUid == uid
        && getAfter(listingPath(id)).data.status == 'draft';
    }

    function validListingKeys(data) {
      return data.keys().hasOnly([
        'providerUid', 'providerName', 'title', 'description', 'category',
        'quantity', 'unit', 'storageRequirement', 'storageInstructions',
        'allergenInfo', 'allergenDeclaration', 'pickupAddress', 'pickupLocation',
        'pickupStartsAt', 'pickupDeadline', 'bestBeforeAt', 'useByAt',
        'status', 'createdAt',
        'updatedAt', 'demoImageKey',
        'acceptedOrganizationUid', 'collectedAt'
      ]);
    }

    function validReview(before, after, auditPathValue, uid, auditId) {
      let audit = getAfter(auditPathValue).data;
      return !exists(auditPathValue)
        && before.verificationStatus in ['pending', 'approved', 'rejected']
        && after.verificationStatus in ['approved', 'rejected']
        && after.lastAuditId == auditId
        && after.rejectionReason == (after.verificationStatus == 'rejected' ? audit.reason : '')
        && (after.verificationStatus != 'rejected' || validText(audit.reason, 500))
        && audit.adminUid == request.auth.uid
        && audit.targetUid == uid
        && audit.previousStatus == before.verificationStatus
        && audit.newStatus == after.verificationStatus
        && audit.action == 'review_profile'
        && audit.createdAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && exactFields(request.resource.data, ['role', 'accountStatus', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.role in ['provider', 'organization']
        && request.resource.data.accountStatus == 'active'
        && validText(request.resource.data.displayName, 80)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if isOwner(uid)
        && exactFields(request.resource.data, ['name', 'type', 'verificationStatus'])
        && validText(request.resource.data.name, 120)
        && request.resource.data.type in ['provider', 'organization']
        && request.resource.data.verificationStatus == 'pending'
        && getAfter(userPath(uid)).data.role == request.resource.data.type
        && getAfter(userPath(uid)).data.accountStatus == 'active';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'lastAuditId', 'rejectionReason'])
        && request.resource.data.lastAuditId is string
        && request.resource.data.lastAuditId.matches('^[A-Za-z0-9]{20}$')
        && validReview(resource.data, request.resource.data, auditPath(request.resource.data.lastAuditId), uid, request.resource.data.lastAuditId);
    }

    match /adminAuditLogs/{auditId} {
      allow get: if isAdmin();
      allow list: if isAdmin() && request.query.limit <= 50;
      allow create: if isAdmin() && auditId.matches('^[A-Za-z0-9]{20}$')
        && exactFields(request.resource.data, ['adminUid', 'targetUid', 'action', 'reason', 'previousStatus', 'newStatus', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.matches('^[^/]{1,128}$')
        && validReview(get(profilePath(request.resource.data.targetUid)).data,
          getAfter(profilePath(request.resource.data.targetUid)).data,
          auditPath(auditId), request.resource.data.targetUid, auditId);
    }

    match /foodListings/{listingId} {
      allow get: if (request.auth != null && resource.data.providerUid == request.auth.uid)
        || isAdmin()
        || (resource.data.status == 'open' && isApprovedOrganization(request.auth.uid))
        || (isApprovedOrganization(request.auth.uid) && exists(requestPath(listingId, request.auth.uid)));

      allow list: if (request.auth != null && resource.data.providerUid == request.auth.uid && request.query.limit <= 50)
        || (isApprovedOrganization(request.auth.uid) && resource.data.status == 'open' && request.query.limit <= 50)
        || (isAdmin() && request.query.limit <= 50);

      allow create: if isApprovedProvider(request.auth.uid)
        && request.resource.data.providerUid == request.auth.uid
        && request.resource.data.providerName == get(profilePath(request.auth.uid)).data.name
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validListingKeys(request.resource.data)
        && !('acceptedOrganizationUid' in request.resource.data)
        && !('collectedAt' in request.resource.data)
        && (
          (request.resource.data.status == 'draft'
            && request.resource.data.keys().hasAll(['providerUid', 'providerName', 'title', 'status', 'createdAt', 'updatedAt'])
            && validText(request.resource.data.title, 120))
          ||
          (request.resource.data.status == 'open'
            && request.resource.data.keys().hasAll(['providerUid', 'providerName', 'title', 'description', 'category', 'quantity', 'unit', 'storageRequirement', 'storageInstructions', 'allergenInfo', 'allergenDeclaration', 'pickupAddress', 'pickupLocation', 'pickupStartsAt', 'pickupDeadline', 'status', 'createdAt', 'updatedAt'])
            && validListingDetails(request.resource.data))
        );

      function selectedRequestAfter(status, clearConfirmation) {
        let selected = requestPath(listingId, resource.data.acceptedOrganizationUid);
        let before = get(selected).data;
        let after = getAfter(selected).data;
        return before.status == 'approved' && after.status == status
          && after.updatedAt == request.time
          && (!clearConfirmation || !('recipientConfirmedAt' in after));
      }

      function validDraftTransition() {
        return isListingProvider(resource.data)
          && !('acceptedOrganizationUid' in request.resource.data)
          && !('collectedAt' in request.resource.data)
          && (request.resource.data.status == 'draft'
            ? validText(request.resource.data.title, 120)
            : request.resource.data.status == 'open' && validListingDetails(request.resource.data));
      }

      function validAssignment() {
        let uid = request.resource.data.acceptedOrganizationUid;
        let before = get(requestPath(listingId, uid)).data;
        let after = getAfter(requestPath(listingId, uid)).data;
        return isListingProvider(resource.data) && uid is string
          && isEligibleOrganization(uid)
          && request.time + duration.value(15, 'm') <= resource.data.pickupDeadline
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedOrganizationUid', 'updatedAt'])
          && before.status == 'requested' && before.canMeetStorageRequirement == true
          && before.plannedPickupAt >= request.time
          && before.plannedPickupAt >= resource.data.pickupStartsAt
          && before.plannedPickupAt <= resource.data.pickupDeadline
          && after.status == 'approved' && after.updatedAt == request.time;
      }

      function validCollection() {
        return isListingProvider(resource.data)
          && request.resource.data.collectedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'collectedAt', 'updatedAt'])
          && validPickupCollection(resource.data, get(requestPath(listingId, resource.data.acceptedOrganizationUid)).data)
          && selectedRequestAfter('collected', false);
      }

      function validAssignmentCancellation(reopen) {
        return !('acceptedOrganizationUid' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedOrganizationUid', 'updatedAt'])
          && (reopen
            ? request.time + duration.value(15, 'm') <= resource.data.pickupDeadline
              && (isListingProvider(resource.data) || isAssignedRecipient(resource.data))
            : request.time < resource.data.pickupDeadline
              && (isListingProvider(resource.data)
                || (isAssignedRecipient(resource.data) && request.time + duration.value(15, 'm') > resource.data.pickupDeadline)))
          && selectedRequestAfter('cancelled', true);
      }

      function validExpiry(assigned) {
        return request.time >= resource.data.pickupDeadline && canReconcileListing(resource.data)
          && (assigned
            ? !('acceptedOrganizationUid' in request.resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedOrganizationUid', 'updatedAt'])
              && selectedRequestAfter('expired', true)
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      }

      allow update: if request.resource.data.providerUid == resource.data.providerUid
        && request.resource.data.providerName == resource.data.providerName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validListingKeys(request.resource.data)
        && (resource.data.status == 'draft' ? validDraftTransition()
          : resource.data.status == 'open'
            ? (request.resource.data.status == 'assigned' ? validAssignment()
              : request.resource.data.status == 'cancelled'
                ? isListingProvider(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                : request.resource.data.status == 'expired' && validExpiry(false))
            : resource.data.status == 'assigned'
              ? (request.resource.data.status == 'collected' ? validCollection()
                : request.resource.data.status == 'open' ? validAssignmentCancellation(true)
                : request.resource.data.status == 'cancelled' ? validAssignmentCancellation(false)
                : request.resource.data.status == 'expired' && validExpiry(true))
              : false);
      allow delete: if isApprovedProvider(request.auth.uid)
        && resource.data.providerUid == request.auth.uid
        && resource.data.status == 'draft';

      match /photos/{photoId} {
        allow get: if photoId == 'primary'
          && exists(listingPath(listingId))
          && (
            (request.auth != null && get(listingPath(listingId)).data.providerUid == request.auth.uid)
            || isAdmin()
            || (get(listingPath(listingId)).data.status == 'open' && isApprovedOrganization(request.auth.uid))
            || (isApprovedOrganization(request.auth.uid) && exists(requestPath(listingId, request.auth.uid)))
          );

        allow list: if false;

        allow create, update: if photoId == 'primary'
          && isApprovedProvider(request.auth.uid)
          && isParentListingDraft(listingId, request.auth.uid)
          && exactFields(request.resource.data, ['jpeg', 'updatedAt'])
          && request.resource.data.jpeg is bytes
          && request.resource.data.jpeg.size() > 0
          && request.resource.data.jpeg.size() <= 153600
          && request.resource.data.updatedAt == request.time;

        allow delete: if photoId == 'primary'
          && isApprovedProvider(request.auth.uid)
          && isParentListingDraft(listingId, request.auth.uid);
      }

      match /requests/{organizationUid} {
        allow get: if isAdmin()
          || isOwner(organizationUid)
          || (request.auth != null && exists(listingPath(listingId)) && get(listingPath(listingId)).data.providerUid == request.auth.uid);

        allow list: if (isAdmin() && request.query.limit <= 50)
          || (request.auth != null && exists(listingPath(listingId)) && get(listingPath(listingId)).data.providerUid == request.auth.uid && request.query.limit <= 50)
          || (isOwner(organizationUid) && request.query.limit <= 50);

        allow create: if isApprovedOrganization(request.auth.uid)
          && organizationUid == request.auth.uid
          && exists(listingPath(listingId))
          && get(listingPath(listingId)).data.status == 'open'
          && request.time + duration.value(15, 'm') <= get(listingPath(listingId)).data.pickupDeadline
          && request.resource.data.organizationUid == request.auth.uid
          && request.resource.data.providerUid == get(listingPath(listingId)).data.providerUid
          && request.resource.data.organizationName == get(profilePath(request.auth.uid)).data.name
          && request.resource.data.status == 'requested'
          && request.resource.data.canMeetStorageRequirement == true
          && request.resource.data.plannedPickupAt is timestamp
          && request.resource.data.plannedPickupAt >= request.time
          && request.resource.data.plannedPickupAt >= get(listingPath(listingId)).data.pickupStartsAt
          && request.resource.data.plannedPickupAt <= get(listingPath(listingId)).data.pickupDeadline
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasAll([
            'organizationUid', 'providerUid', 'organizationName',
            'plannedPickupAt', 'canMeetStorageRequirement', 'status',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'organizationUid', 'providerUid', 'organizationName',
            'plannedPickupAt', 'canMeetStorageRequirement', 'status',
            'createdAt', 'updatedAt', 'departureLocation'
          ])
          && (!('departureLocation' in request.resource.data) || request.resource.data.departureLocation is latlng);

        function validWithdrawal() {
          return isApprovedOrganization(request.auth.uid) && organizationUid == request.auth.uid
            && resource.data.organizationUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
        }

        function validApproval() {
          let listing = get(listingPath(listingId)).data;
          let after = getAfter(listingPath(listingId)).data;
          return isListingProvider(listing) && isEligibleOrganization(organizationUid)
            && listing.status == 'open'
            && request.time + duration.value(15, 'm') <= listing.pickupDeadline
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && after.status == 'assigned' && after.acceptedOrganizationUid == organizationUid
            && after.updatedAt == request.time;
        }

        function validHandoverConfirmation() {
          let listing = get(listingPath(listingId)).data;
          return isSelectedAssignment(listingId, organizationUid) && isAssignedRecipient(listing)
            && resource.data.organizationUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipientConfirmedAt', 'updatedAt'])
            && (!('recipientConfirmedAt' in request.resource.data)
              || (request.resource.data.recipientConfirmedAt == request.time
                && request.time >= listing.pickupStartsAt && request.time < listing.pickupDeadline));
        }

        function validCollectedRequest() {
          let listing = get(listingPath(listingId)).data;
          let after = getAfter(listingPath(listingId)).data;
          return isSelectedAssignment(listingId, organizationUid) && isListingProvider(listing)
            && validPickupCollection(listing, resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && after.status == 'collected' && after.collectedAt == request.time
            && after.updatedAt == request.time;
        }

        function validClosedRequest(expire) {
          let listing = get(listingPath(listingId)).data;
          let after = getAfter(listingPath(listingId)).data;
          return isSelectedAssignment(listingId, organizationUid)
            && !('recipientConfirmedAt' in request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recipientConfirmedAt', 'updatedAt'])
            && !('acceptedOrganizationUid' in after) && after.updatedAt == request.time
            && (expire
              ? request.time >= listing.pickupDeadline && canReconcileListing(listing) && after.status == 'expired'
              : (isListingProvider(listing) || isAssignedRecipient(listing)) && after.status in ['open', 'cancelled']);
        }

        allow update: if request.resource.data.updatedAt == request.time
          && (resource.data.status == 'requested'
            ? (request.resource.data.status == 'withdrawn' ? validWithdrawal()
              : request.resource.data.status == 'approved' && validApproval())
            : resource.data.status == 'approved'
              ? (request.resource.data.status == 'approved' ? validHandoverConfirmation()
                : request.resource.data.status == 'collected' ? validCollectedRequest()
                : request.resource.data.status == 'cancelled' ? validClosedRequest(false)
                : request.resource.data.status == 'expired' && validClosedRequest(true))
              : false);
        allow delete: if false;
      }
    }

    match /{path=**}/requests/{organizationUid} {
      allow get: if (request.auth != null && resource.data.organizationUid == request.auth.uid)
        || isAdmin();
      allow list: if request.query.limit <= 50
        && ((request.auth != null && resource.data.organizationUid == request.auth.uid) || isAdmin());
    }
  }
}
