# Expo public Firebase client configuration.
# Values are placeholders; obtain the real client configuration from your Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_me
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_me
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
EXPO_PUBLIC_FIREBASE_APP_ID=replace_me

# If using a maps provider, add a restricted client key here only after reviewing
# provider requirements. Never put privileged server credentials in the app.
EXPO_PUBLIC_MAPS_API_KEY=replace_me
